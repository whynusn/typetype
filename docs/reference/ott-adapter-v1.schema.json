{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ott-adapter-v1.schema.json",
  "title": "OTT Adapter Package v1",
  "description": "适配器包清单（adapter.json）权威 schema。ADR-011 Phase 2.1。",
  "type": "object",
  "required": ["protocol", "version", "adapter_id", "name", "repo_id", "type", "checksum", "signature"],
  "properties": {
    "protocol": {
      "const": "ott-adapter"
    },
    "version": {
      "const": 1
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["script", "rule", "instance"]
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "rights": {
      "type": "object",
      "properties": {
        "min_api_level": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.-]+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": {
                "type": "string"
              },
              "weight": {
                "type": "integer",
                "minimum": 1
              },
              "health": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "string"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": ["pubkey", "sig"],
      "properties": {
        "pubkey": {
          "type": "string",
          "pattern": "^(ed25519:)?[0-9a-f]{64}$"
        },
        "sig": {
          "type": "string",
          "pattern": "^(ed25519:)?[0-9a-f]{128}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["script", "rule"]
          }
        }
      },
      "then": {
        "required": ["content"],
        "properties": {
          "content": {
            "required": ["path"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "instance"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "required": ["endpoints"]
          }
        }
      }
    }
  ]
}
