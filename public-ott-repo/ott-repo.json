{
  "protocol": "ott-repo",
  "version": "1.0",
  "type": "repository",
  "repo_id": "typetype-default",
  "name": "TypeType 默认文本源",
  "description": "官方维护的默认文本库，包含经典中文短句和每日一言。",
  "maintainer": {
    "name": "typetype",
    "homepage": "https://github.com/whynusn/typetype"
  },
  "license": "CC-BY-SA-4.0",
  "updated_at": "2026-07-27T00:00:00+08:00",
  "mirrors": [
    {"url": "https://raw.githubusercontent.com/whynusn/typetype/main/public-ott-repo/ott-repo.json", "priority": 1},
    {"url": "https://cdn.jsdelivr.net/gh/whynusn/typetype@main/public-ott-repo/ott-repo.json", "priority": 2}
  ],
  "sources": [
    {
      "type": "ott-instance",
      "authority": "typetype-default-static",
      "label": "经典中文短句",
      "endpoints": [
        {"url": "https://raw.githubusercontent.com/whynusn/typetype/main/public-ott-repo/static/", "profile": "static", "priority": 1},
        {"url": "https://cdn.jsdelivr.net/gh/whynusn/typetype@main/public-ott-repo/static/", "profile": "static", "priority": 2}
      ],
      "tags": ["chinese", "classic", "static"],
      "default_enabled": true
    },
    {
      "type": "ott-rule",
      "rule_id": "hitokoto",
      "label": "一言（Hitokoto）",
      "rule": {
        "kind": "json-api",
        "request": {
          "url": "https://v1.hitokoto.cn/?c=i",
          "method": "GET",
          "headers": {"Accept": "application/json"}
        },
        "extract": {"title": "$.from", "content": "$.hitokoto"},
        "transform": ["trim"]
      },
      "tags": ["quote", "chinese", "realtime"],
      "default_enabled": true
    },
    {
      "type": "ott-script",
      "url": "https://raw.githubusercontent.com/whynusn/typetype/main/public-ott-repo/scripts/daily_quote.py",
      "label": "每日Quotes脚本",
      "tags": ["quote", "script"],
      "default_enabled": false
    }
  ]
}
